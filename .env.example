# Configuración de Entorno de NameGuess

# Google Identity Services (GIS) Client ID
# Obtén tu Client ID en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# URL Base de la aplicación
VITE_APP_URL=https://nameguess.app

# Modo de datos ('production' o 'development')
VITE_DATA_MODE=production

# Zona horaria de referencia para el desafío diario (por defecto UTC)
VITE_DAILY_TIMEZONE=UTC
